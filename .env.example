# ============================================
# novel_auto_agent 环境变量配置
# ============================================

# ---- Jellyfish 后端 ----
APP_NAME=novel_auto_agent
DATABASE_URL=sqlite+aiosqlite:///./jellyfish.db
REDIS_URL=redis://localhost:6379/0

# ---- LLM Provider (Pipeline 用) ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Pipeline 控制 ----
MAX_REPLAN_ROUNDS=3
PIPELINE_OUTPUT_DIR=./output
PIPELINE_LOG_LEVEL=INFO

# ---- 存储 (可选) ----
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
